{
  "name": "hebrew-backend",
  "version": "1.0.0",
  "description": "Backend API for Hebrew Learning",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "grammar:build": "node scripts/convert-grammar-data.mjs",
    "db:schema": "node scripts/createSchema.js",
    "seed:vocabulary": "node scripts/seedVocabulary.js",
    "seed:verb-grammar": "node scripts/seedVerbGrammar.js",
    "seed:adjective-grammar": "node scripts/seedAdjectiveGrammar.js",
    "seed:adverb-grammar": "node scripts/seedAdverbGrammar.js",
    "content:reset": "node scripts/resetContent.js",
    "content:rebuild": "npm run grammar:build && npm run content:reset"
  },
  "keywords": [
    "hebrew",
    "learning",
    "nodejs",
    "backend"
  ],
  "author": "Roman Rozhdestvenskii",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
